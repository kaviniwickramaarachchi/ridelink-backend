{
  "info": {
    "name": "RideLink - Account Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Account-only requests. Set demoPassword locally. Run Account then Negative Tests; Admin requires a manually promoted admin."
  },
  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Register passenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Passenger Demo\",\n  \"email\": \"{{passengerEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"phoneNumber\": \"0771234567\",\n  \"role\": \"PASSENGER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('passengerId', pm.response.json().id);",
                  "pm.test('No password disclosed', () => { pm.expect(pm.response.json()).not.to.have.property('passwordHash'); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('passengerEmail', 'passenger.' + Date.now() + '@example.com');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login passenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{passengerEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('passengerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
